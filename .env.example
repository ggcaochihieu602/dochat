# Secrets được dùng chung bởi Cloudflare Worker và Render backend.
# Không bao giờ commit file .env lên GitHub.

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
ALLOWED_USER_IDS=851987991

# Worker -> Render
INTERNAL_SECRET=
BACKEND_URL=https://your-service.onrender.com

# Render backend -> Worker /internal/summarize
SUMMARY_PROVIDER_URL=https://your-worker.workers.dev/internal/summarize

# Viettel AI TTS (chỉ cần trên Render)
VIETTEL_TTS_TOKEN=
VIETTEL_TTS_VOICE=hn-quynhanh
VIETTEL_TTS_SPEED=1.0
VIETTEL_TTS_FILTER=false
GOOGLE_VISION_API_KEY=

# Giới hạn (tùy chọn)
MAX_TTS_WORDS=600
MAX_TTS_CHARS=5000
